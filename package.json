{
  "name": "nimblescape-mindbug",
  "displayName": "nimblescape Mindbug",
  "description": "Shows the stack (one scope for each function call) and the heap of a paused TypeScript program (Deno) as a diagram, to help students learn how memory works.",
  "version": "0.1.0",
  "publisher": "nimblescape",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/nimblescape-mindbug.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Education",
    "Visualization"
  ],
  "keywords": [
    "deno",
    "typescript",
    "heap",
    "stack",
    "memory",
    "education",
    "python tutor",
    "uml"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nimblescape.mindbug.open",
        "title": "Open Mindbug",
        "icon": {
          "light": "media/memory-light.svg",
          "dark": "media/memory-dark.svg"
        }
      },
      {
        "command": "nimblescape.mindbug.run",
        "title": "Run with Mindbug",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nimblescape.mindbug.run",
          "when": "resourceLangId == typescript && !inDebugMode",
          "group": "navigation"
        },
        {
          "command": "nimblescape.mindbug.open",
          "when": "inDebugMode",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nimblescape.mindbug.run",
          "when": "resourceLangId == typescript"
        }
      ]
    },
    "configuration": {
      "title": "nimblescape Mindbug",
      "properties": {
        "nimblescape.mindbug.denoPath": {
          "type": "string",
          "default": "deno",
          "markdownDescription": "Path to the Deno program, used by **Run with Mindbug**. The default `deno` works when Deno is on the `PATH`."
        },
        "nimblescape.mindbug.inspectPort": {
          "type": "number",
          "default": 9229,
          "description": "Port on which Deno waits for the debugger. Change it when another program uses port 9229."
        },
        "nimblescape.mindbug.stopOnEntry": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When on, **Run with Mindbug** pauses at the first line of the program, so you can step from the start."
        },
        "nimblescape.mindbug.openAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Open the Mindbug view when a debug session pauses for the first time."
        },
        "nimblescape.mindbug.maxHistorySteps": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum number of steps that the Mindbug view keeps, so that you can go back to an earlier step. When there are more steps, the oldest steps are removed."
        },
        "nimblescape.mindbug.maxObjects": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of heap objects that are read per scope."
        },
        "nimblescape.mindbug.maxArrayItems": {
          "type": "number",
          "default": 100,
          "minimum": 5,
          "maximum": 2000,
          "description": "Maximum number of array items, set members and map entries that are shown per object."
        },
        "nimblescape.mindbug.maxStringLength": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum number of characters that are shown per string."
        }
      }
    },
    "debuggers": [
      {
        "type": "node",
        "configurationSnippets": [
          {
            "label": "Mindbug: Debug a TypeScript file with Deno",
            "description": "Runs a TypeScript file with Deno and shows its memory in the Mindbug view.",
            "body": {
              "type": "node",
              "request": "launch",
              "name": "Deno: ${1:main.ts}",
              "program": "^\"\\${workspaceFolder}/${1:main.ts}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "runtimeExecutable": "deno",
              "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-all"
              ],
              "attachSimplePort": 9229
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deno": "vitest run --config vitest.deno.config.mts",
    "test:render": "node esbuild.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/render/screenshots.ts",
    "test:vscode": "node esbuild.mjs && node scripts/build-vscode-tests.mjs && vscode-test --label vscode",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "install-local": "node scripts/install-local.mjs",
    "uninstall-local": "node scripts/uninstall-local.mjs",
    "record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/render/record.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "diff": "^8.0.3",
        "serialize-javascript": "^7.1.2"
      }
    }
  },
  "license": "MIT"
}
