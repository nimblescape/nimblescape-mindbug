{
  "version": "0.2.0",
  "configurations": [
    {
      // Mindbug starts the file of the active editor with Deno, or with Node.js when Deno is not installed.
      "name": "Mindbug: current file",
      "type": "mindbug",
      "request": "launch",
      "program": "${file}"
    },
    {
      // A launch configuration of VS Code's JavaScript debugger, without Mindbug: the Mindbug view shows it too.
      "name": "Node.js: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "stopOnEntry": true,
      "console": "internalConsole"
    }
  ]
}
