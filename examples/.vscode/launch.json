{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deno: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--inspect-brk=127.0.0.1:9229", "--allow-all"],
      "attachSimplePort": 9229,
      "console": "internalConsole",
      "outputCapture": "std"
    }
  ]
}
